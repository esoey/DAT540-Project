    "#Grid search function\n",
    "def grid_search(model: str, param_grid: dict, score: str = \"roc_auc\"):\n",
    "    '''\n",
    "    Tune one model's hyperparameters with cross-validated grid search.\n",
    "\n",
    "    Every combination in param_grid is tried with stratified 5-fold CV on the training set, scored by ROC-AUC. Prints the best parameters and their mean CV score.\n",
    "\n",
    "    Parameters:\n",
    "        model (str): Name of a model in the `models` dict, e.g. \"Logistic Regression\" or \"KNN\".\n",
    "        param_grid (dict): Hyperparameters to try. Keys use the pipeline prefix, e.g. {\"model__C\": [0.01, 0.1, 1, 10]}.\n",
    "        score (str): Metric used to rank the grid combinations, e.g. \"roc_auc\" or \"recall\". Default \"roc_auc\".\n",
    "    '''\n",
    "\n",
    "    grid_search = GridSearchCV(estimator=models[model],\n",
    "                            param_grid=param_grid,\n",
    "                            cv=cross_validation,\n",
    "                            scoring=score,\n",
    "                            return_train_score=True)\n",
    "\n",
    "    grid_search.fit(X_train_selected, y_train)\n",
    "\n",
    "    print(\"Best parameters: \", grid_search.best_params_)\n",
    "    print(\"Best score: \", grid_search.best_score_)\n",
    "\n",
    "    return grid_search"
   ]
  },
