    "#Medical ranges\n",
    "medical_ranges = {\n",
    "    'Age': (18, 100),\n",
    "    'Body Mass Index (BMI)': (15, 50),\n",
    "    'C-Reactive Protein (CRP)': (0, 400),  \n",
    "    'Creatinine': (0.5, 5.0), \n",
    "    'Glucose': (50, 400),  \n",
    "    'Hemoglobin (HGB)': (8, 20),\n",
    "    'High Density Lipoprotein (HDL)': (20, 100), \n",
    "    'Low Density Lipoprotein (LDL)': (50, 300), \n",
    "    'Total Cholesterol (TC)': (100, 400), \n",
    "    'Triglyceride': (30, 1000),  \n",
    "    'Vitamin D': (2, 150),\n",
    "    'Obesity (%)': (0, 200)\n",
    "}\n",
    "\n",
    "flagged = []\n",
    "for feature, (low, high) in medical_ranges.items():\n",
    "    outside = gd_df[(gd_df[feature] < low) | (gd_df[feature] > high)]\n",
    "    for row, value in outside[feature].items():\n",
    "        flagged.append({\"row\": row, \"feature\": feature, \"value\": value, \"allowed\": f\"{low} to {high}\"})\n",
    "flagged = pd.DataFrame(flagged)\n",
    "\n",
    "print(f\"{len(flagged)} values outside reasonable range\")\n",
    "flagged\n",
    "\n",
    "# Box plot for medical ranges\n",
    "continuous = [c for c in gd_df.columns if gd_df[c].nunique() > 10]\n",
    "flagged_features = list(flagged[\"feature\"].unique())\n",
    "others = sorted([for f in continuous if f not in flagged_features], key=lambda f: outlier_results[f]['count'], reverse=True)\n",
    "high_outlier_features = flagged_features + others\n",
    "\n",
    "if len(high_outlier_features) > 0:\n",
    "    n_plots = min(6, len(high_outlier_features))\n",
    "    fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "    axes = axes.ravel()\n",
    "\n",
    "    for i, feature in enumerate(high_outlier_features[:n_plots]):\n",
    "        axes[i].boxplot(gd_df[feature], patch_artist=True, boxprops=dict(facecolor=\"lightblue\"))\n",
    "        axes[i].set_title(f'{feature}' \\n({outlier_results[feature][\"count\"]} outliers, {outlier_results[feature][\"percentage\"]:.1f}%)')\n",
    "        axes[i].set_xticks([])\n",
    "        axes[i].grid(True, alpha=0.3)\n",
    "\n",
    "    # dashed lines at the medical limits\n",
    "    for limit in medical_ranges.get(feature, []):\n",
    "        if gd_df[feature].min() <= limit <=gd_df[feature].max():\n",
    "            axes[i].axhline(limit, color='gray', linestyle='--')\n",
    "\n",
    "    # red X for values outside the possible range\n",
    "    for _, r in flagged[flagged['feature'] == feature].iterrows():\n",
    "        axes[i].plot(1, r['value'], 'rX', markerSize=10)\n",
    "        axes[i].annotate(f\"row {r['row']}: {r['value']:g}\", (1, r['value']), xytext=(10, 5), textcoords='offset points')\n",
    "\n",
    "    #remove empty subplots\n",
    "    for j in range(n_plots, len(axes)):\n",
    "        fig.delaxes(axes[j])\n",
    "\n",
    "    fig.suptitle(\"Dashed line = medical limit, red X = outside the possible range\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "else:\n",
    "    print(\"No features to visualize\")"
   ]
  },
