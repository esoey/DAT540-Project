    "F_vals, p_vals = f_classif(X_train_selected, y_train)\n",
    "feature_names = X_train_selected.columns\n",
    "\n",
    "assert len(feature_names) == len(F_vals)\n",
    "\n",
    "f_table = pd.DataFrame({\n",
    "    \"feature\": feature_names,\n",
    "    \"F_score\": F_vals,\n",
    "    \"p_value\": p_vals\n",
    "}).sort_values(\"F_score\", ascending=False)\n",
    "\n",
    "# ANOVA F-score Analysis Summary\n",
    "print(\"=\"*60)\n",
    "print(\"ANALYSIS OF VARIANCE (ANOVA) F-SCORE ANALYSIS\")\n",
    "print(\"=\"*60)\n",
    "print(f\"\\nTotal features analyzed: {len(F_vals)}\")\n",
    "print(f\"F-score range: {F_vals.min():.3f} to {F_vals.max():.3f}\")\n",
    "print(f\"Mean F-score: {F_vals.mean():.3f}\")\n",
    "print(f\"Median F-score: {np.median(F_vals):.3f}\")\n",
    "print(f\"Std deviation: {F_vals.std():.3f}\")\n",
    "print(f\"\\nFeatures with F >= 1.0: {(F_vals >= 1.0).sum()}\")\n",
    "print(f\"Features with F >= 0.70: {(F_vals >= 0.70).sum()}\")\n",
    "\n",
    "print(f\"Features with p < 0.001: {(p_vals < 0.001).sum()} (extremely significant) (***)\")\n",
    "print(f\"Features with p < 0.01: {(p_vals < 0.01).sum()} (highly significant) (**)\")\n",
    "print(f\"Features with p < 0.05: {(p_vals < 0.05).sum()} (statistically significant) (*)\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"TOP FEATURES BY ANOVA F-SCORE\")\n",
    "print(\"=\"*60)\n",
    "for _, row in f_table.iterrows():\n",
    "    significance = \"***\" if row['p_value'] < 0.001 else \"**\" if row['p_value'] < 0.01 else \"*\" if row['p_value'] < 0.05 else \"\"\n",
    "    print(f\"{row['feature']:<35} F={row['F_score']:>8.3f}  p={row['p_value']:.4e} {significance}\")\n",
    "\n",
    "print(\"\\nSignificance: (***) p<0.001, (**) p<0.01, (*) p<0.05\")\n",
    "\n",
    "# Select features\n",
    "selected_df = f_table[f_table[\"F_score\"] >= 0.70]\n",
    "selected_features = selected_df[\"feature\"].tolist()\n",
    "\n",
    "print(f\"\\nSelected {len(selected_features)} features (F >= 0.70):\")\n",
    "for i, row in enumerate(selected_df.itertuples(), 1):\n",
    "    print(f\"{i:2d}. {row.feature:<35} (F={row.F_score:.3f})\")\n",
    "\n",
    "# Transform the data\n",
    "X_train_anova = X_train_selected[selected_features]    \n",
    "X_valid_anova = X_valid_selected[selected_features]\n",
    "\n",
    "print(f\"\\nOriginal features: {X_train_selected.shape[1]}\")\n",
    "print(f\"Selected features: {X_train_selected.shape[1]}\")\n",
    "\n",
    "# Compare baseline model performance with feature selection\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"Performance Comparison: All Features vs. Feature Selection\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "for name, clf in models.items():\n",
    "    clf_all = clone(clf)\n",
    "    clf_selected = clone(clf)\n",
    "\n",
    "    clf_all.fit(X_train_selected, y_train)\n",
    "    y_pred_all = clf_all.predict_proba(X_valid_selected)[: ,1]\n",
    "    roc_auc_all = roc_auc_score(y_valid, y_pred_all)\n",
    "\n",
    "    clf_selected.fit(X_train_anova, y_train)\n",
    "    y_pred_selected = clf_selected.predict_proba(X_valid_anova)[: ,1]\n",
    "    roc_auc_selected = roc_auc_score(y_valid, y_pred_selected)\n",
    "\n",
    "    print(f\"\\n{name}:\")\n",
    "    print(f\"  All features ({X_train_selected.shape[1]}):      ROC-AUC = {roc_auc_all:.4f}\")\n",
    "    print(f\"  Selected features ({len(selected_features)}):  ROC-AUC = {roc_auc_selected:.4f}\")\n",
    "    print(f\"  Difference:                {roc_auc_selected - roc_auc_all:+.4f}\")"
   ]
